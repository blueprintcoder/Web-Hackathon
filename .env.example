# Environment Variables Template
# Copy this file to .env and set your database connection

# PostgreSQL Cloud Database URL (Supabase or Neon)
DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"

# NextAuth / Session Secret
NEXTAUTH_SECRET="your-super-secret-jwt-key-min-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"
